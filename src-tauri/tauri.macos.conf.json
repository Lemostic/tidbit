{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tidbit.app",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "tidbit",
        "url": "index.html",
        "width": 780,
        "height": 1100,
        "minWidth": 520,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
